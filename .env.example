# =========================================================
# YT001 — environment template (copy to `.env` and fill in)
# `.env` is git-ignored. Never commit real keys.
# Variable names below match app/core/config.py exactly.
# =========================================================

# ---------- Ollama (local LLM) ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2:3b
OLLAMA_REASONING_MODEL=deepseek-r1:7b
# HTTP timeout (seconds) for Ollama calls.
OLLAMA_TIMEOUT=900

# ---------- Voice / BGM ----------
TTS_VOICE=en-US-ChristopherNeural
BGM_VOLUME=0.10

# ---------- Directories (relative to the project root) ----------
PROJECTS_DIR=projects
CACHE_DIR=cache
ASSETS_DIR=assets

# ---------- Visual providers ----------
# VISUAL_PROVIDER: test | comfyui
VISUAL_PROVIDER=test
TEST_VISUAL_MODE=true
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_MODEL=sd_xl_base_1.0.safetensors
VISUAL_SEED=12345
# Bump to invalidate AI images that contained embedded text.
VISUAL_CACHE_VERSION=v2_no_text
# Leave the default global negative prompt unless you know what you are doing.
# VISUAL_NEGATIVE_PROMPT=

# ---------- Hybrid visual sources (stock / local assets / AI fallback) ----------
# VISUAL_SOURCE_MODE: auto | ai | stock | local
VISUAL_SOURCE_MODE=auto
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here
STOCK_MAX_RESULTS=10
STOCK_MIN_WIDTH=1280
STOCK_MIN_HEIGHT=720
STOCK_TIMEOUT=30
STOCK_MAX_RETRIES=2
STOCK_SAFESEARCH=true
STOCK_ALLOW_VIDEO=true
STOCK_MIN_VIDEO_SECONDS=3
STOCK_VIDEO_MAX_BYTES=26214400
# STOCK_MEDIA_PREFERENCE: photo | video | any
STOCK_MEDIA_PREFERENCE=photo
STOCK_CACHE_TTL_HOURS=168
STOCK_CACHE_VERSION=v1_hybrid
# Folder name searched inside assets/ and projects/<id>/ for local stock.
LOCAL_STOCK_DIRNAME=stock
# Offline deterministic mock stock providers (tests only).
STOCK_MOCK_MODE=false

# ---------- Captions (renderer stage only) ----------
CAPTION_ENABLED=true
# CAPTION_POSITION: lower_third | center
CAPTION_POSITION=lower_third
CAPTION_FONT_SIZE=48
CAPTION_MAX_WIDTH_RATIO=0.86
CAPTION_BG_OPACITY=160
CAPTION_VERSION=v1

# ---------- Script generation / duration targets ----------
SCRIPT_WPS=2.5
SCENE_MIN_SECONDS=5
SCENE_MAX_SECONDS=30
SCRIPT_TARGET_MIN_SECONDS=180
SCRIPT_TARGET_MAX_SECONDS=240
SCRIPT_MIN_SCENES=8
SCRIPT_MAX_SCENES=16
SCRIPT_EXPAND_RETRIES=2
SCRIPT_NUM_CTX=8192
SCRIPT_MAX_TOKENS=4096
# Dedicated model for long-form SCRIPT generation. If the preferred model is
# not installed, generation automatically falls back to OLLAMA_TEXT_MODEL.
# Keep a NON-THINKING model here: Ollama's JSON mode ("format": "json") is what
# makes the long structured reply reliable, and reasoning builds cannot follow
# it - deepseek-r1:7b returns an EMPTY "{}" under JSON mode (measured 2026-09-22:
# 6 chars in ~24s), which used to kill SCRIPT with "scenes must be a non-empty
# list". The engine now calls reasoning models in PLAIN mode automatically
# (script_engine.json_mode_supported), but they are much slower (~5-15 min per
# attempt) and can truncate at SCRIPT_MAX_TOKENS, so llama3.2:3b stays the default.
SCRIPT_MODEL=llama3.2:3b
# Optional opt-in: SCRIPT_MODEL=deepseek-r1:7b (raise SCRIPT_MAX_TOKENS to ~6144).
# Use Ollama structured JSON output ("format": "json") on script calls.
SCRIPT_JSON_MODE=true
# Per-scene spoken-narration budget, translated into prompt word counts.
# Duration estimation itself still uses real narration word counts.
# SCRIPT_NARRATION_MIN_SECONDS=15
# SCRIPT_NARRATION_MAX_SECONDS=25

# ---------- Image / video render ----------
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720
VIDEO_FPS=30
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_CRF=20
VIDEO_PRESET=medium

# ---------- Research / niche ----------
CHANNEL_NICHE=Modern Stoicism and Applied Psychology
CHANNEL_LANGUAGE=en
TARGET_COUNTRY=US
RESEARCH_REGION=US
TARGET_AUDIENCE=Adults interested in self improvement
# RESEARCH_PROVIDER: test | youtube
RESEARCH_PROVIDER=test
TEST_RESEARCH_MODE=true
YOUTUBE_API_KEY=
YOUTUBE_RESEARCH_ENABLED=false
RESEARCH_CACHE_TTL_HOURS=24
YOUTUBE_MAX_RESULTS=25
YOUTUBE_MAX_QUERIES_PER_RUN=10
TOPIC_COUNT=12
# Optional override; comma-separated search queries.
# RESEARCH_QUERIES=stoicism anxiety,stoicism overthinking

# ---------- Dashboard ----------
LOGS_DIR=logs
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# ---------- YouTube OAuth upload (DIFFERENT from YOUTUBE_API_KEY research key) ----------
YOUTUBE_ENABLED=false
YOUTUBE_UPLOAD_ENABLED=false
TEST_YOUTUBE_MODE=true
YOUTUBE_CLIENT_SECRET_FILE=credentials/client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
YOUTUBE_OAUTH_PORT=8765
YOUTUBE_DEFAULT_PRIVACY=private
